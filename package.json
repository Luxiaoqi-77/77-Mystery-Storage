{
  "name": "desktop-pet",
  "version": "0.1.0",
  "description": "A small always-on-top desktop pet.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "electron:build": "electron-builder --win portable",
    "tauri:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"New-Item -ItemType Directory -Force -Path src/assets | Out-Null; Copy-Item -Path assets/pet -Destination src/assets -Recurse -Force\"",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build": "tauri build"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.shen-xiao-hui",
    "productName": "沈小回",
    "artifactName": "沈小回.exe",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "portable"
    }
  }
}
